# Docker Compose in-container networking only.
# Hostnames `postgres` and `redis` resolve inside the Compose network.
# Do NOT install Postgres or Redis on the host. Start with: docker compose up --build

LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Chat: openrouter/free = $0 tokens (rate-limited). Paid example: openai/gpt-4o-mini
LLM_MODEL=openrouter/free
LLM_MAX_TOKENS=1024
EMBEDDING_MODEL=openai/text-embedding-3-small
# If you switch to text-embedding-3-large, set EMBEDDING_DIMENSIONS=3072,
# alter the code_chunks.embedding vector column, and run a full Analyze (not Incremental).
EMBEDDING_DIMENSIONS=1536
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/app_db
REDIS_URL=redis://redis:6379/0
GITHUB_TOKEN=
DATA_DIR=/data
INDEX_QUEUE_KEY=index_jobs
CORS_ORIGINS=http://localhost:3000
GIT_CLONE_DEPTH=200
GIT_HISTORY_MAX_COMMITS=200
# RAG: heuristic (default, no API) or llm for optional re-scoring
RERANK_MODE=heuristic
RETRIEVE_CANDIDATES=40
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRE_MINUTES=10080
INDEX_MAX_ATTEMPTS=3
